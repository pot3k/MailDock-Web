{
  "name": "maildock-web",
  "productName": "MailDock Web",
  "version": "0.1.0",
  "description": "MailDock Web",
  "author": "pot3k",
  "license": "MIT",
  "repository": "github:pot3k/MailDock-Web",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.pot3k.maildock.web",
    "copyright": "Copyright © 2026 pot3k",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "gmail-preload.js",
      "shell.html",
      "sounds/*.wav",
      "icon.png",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Email link",
        "schemes": [
          "mailto"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pot3k",
        "repo": "MailDock-Web"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
